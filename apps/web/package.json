    "lucide-react": "0.474.0",
    "najm-auth": "3.2.1",
    "najm-core": "2.0.5",
    "najm-i18n": "2.0.3",
    "najm-kit": "2.11.12",
    "najm-next": "0.2.0",
    "najm-theme": "0.2.1",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.81.0",
    "screenfull": "^6.0.2",
    "sharp": "0.34.5",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.14",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "bcryptjs": "3.0.2",
