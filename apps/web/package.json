  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "bun --bun next typegen && tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun --env-file=.env.local scripts/run-phase6-e2e.ts",
