# Copy to /opt/mail-test-hub/hub.env on the VPS and set mode 0600.
# Generate every password/token independently; do not reuse application secrets.
MAIL_TEST_DASHBOARD_USER=mail-admin
MAIL_TEST_DASHBOARD_PASSWORD=replace-with-a-long-random-dashboard-password

# One token and one or more exclusive recipient domains per application.
# Keep this JSON on one line. Tokens must be at least 32 characters and unique.
MAIL_TEST_GATEWAY_APPS_JSON=[{"id":"kafil","token":"replace-with-a-unique-kafil-token-at-least-32-characters","recipientDomains":["c4a-sponsor.test"]},{"id":"school","token":"replace-with-a-unique-school-token-at-least-32-characters","recipientDomains":["school-e2e.test"]}]

# Mailpit accepts only test recipients in these namespaces.
MAIL_TEST_SMTP_ALLOWED_RECIPIENTS=@(c4a-sponsor\.test|school-e2e\.test)$
MAIL_TEST_MAX_MESSAGES=5000
MAIL_TEST_MAX_AGE=7d

# Host-loopback bindings consumed by the existing VPS HTTPS proxy.
MAIL_TEST_DASHBOARD_LOOPBACK_PORT=59025
MAIL_TEST_GATEWAY_LOOPBACK_PORT=59026
MAIL_TEST_SMTP_LOOPBACK_PORT=59027
